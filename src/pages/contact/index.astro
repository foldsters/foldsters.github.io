---
import LayoutPage from '../../layouts/LayoutPage.astro';
import { CONTACT_ENDPOINT } from '../../config/contact';
---

<LayoutPage title="Foldster's Projects — Contact" description="Start a project">
  <h1>Start a Project</h1>
  <p class="lede">
    Tell us about your stream or channel, your audience, and what you want it to feel like. We'll get back within one week.
  </p>

  <form id="contact-form" class="contact-form" data-endpoint={CONTACT_ENDPOINT} novalidate>
    <label>
      <span>name</span>
      <input type="text" name="name" required />
    </label>

    <label>
      <span>email</span>
      <input type="email" name="email" required />
    </label>

    <label>
      <span>twitch / youtube / bluesky (optional)</span>
      <input type="text" name="creator_handle" />
    </label>

    <label>
      <span>type of project</span>
      <select name="project_type" required>
        <option value="asset-pack">Asset Pack — $360–720 (launch)</option>
        <option value="live-integration" selected>Live Integration — $1,200–2,100 (launch)</option>
        <option value="end-to-end">End-to-End Pipeline — $3,000–6,000 (launch)</option>
        <option value="partnership">Ongoing Tooling Partnership — $300–600/mo (launch)</option>
        <option value="donation">Donation — support the free tools</option>
        <option value="not-sure">Not sure yet — let's talk</option>
      </select>
      <a href="/services/" class="hint mono"><em>not sure what's in each tier? see the breakdown &rarr;</em></a>
    </label>

    <label>
      <span>what do you want it to feel like?</span>
      <textarea name="message" rows="6" required></textarea>
    </label>

    {/* Honeypot — visually hidden, never focusable, off the tab order.
        Bots fill every input; humans never see this one. */}
    <div class="hp" aria-hidden="true">
      <label>
        leave this blank
        <input type="text" name="website" tabindex="-1" autocomplete="off" />
      </label>
    </div>

    <button type="submit" class="cta">Send &rarr;</button>
    <p id="contact-error" class="form-error" role="alert" hidden></p>
  </form>

  <p class="mono note">we respond within one week.</p>
</LayoutPage>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const errorEl = document.getElementById('contact-error') as HTMLParagraphElement | null;
  const submitBtn = form?.querySelector('button[type="submit"]') as HTMLButtonElement | null;

  if (form && errorEl && submitBtn) {
    const endpoint = form.dataset.endpoint ?? '';
    const originalLabel = submitBtn.innerHTML;

    function showError(msg: string) {
      errorEl!.textContent = msg;
      errorEl!.hidden = false;
    }
    function clearError() {
      errorEl!.hidden = true;
      errorEl!.textContent = '';
    }

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      clearError();

      if (!form.reportValidity()) return;

      if (!endpoint || endpoint.includes('YOUR-CONVEX-DEPLOYMENT')) {
        showError('The contact endpoint is not configured yet. Email foldster@foldsters.com directly.');
        return;
      }

      submitBtn.disabled = true;
      submitBtn.innerHTML = 'sending&hellip;';

      const fd = new FormData(form);
      const payload: Record<string, string> = {};
      for (const [k, v] of fd.entries()) payload[k] = typeof v === 'string' ? v : '';

      try {
        const res = await fetch(endpoint, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });

        if (!res.ok) {
          let detail = `status ${res.status}`;
          try {
            const json = await res.json();
            if (json?.error) detail = json.error;
          } catch { /* fall through */ }
          throw new Error(detail);
        }

        window.location.href = '/thanks/';
      } catch (err) {
        const msg = err instanceof Error ? err.message : 'unknown error';
        showError(`Couldn't send: ${msg}. Try again, or email foldster@foldsters.com directly.`);
        submitBtn.disabled = false;
        submitBtn.innerHTML = originalLabel;
      }
    });
  }
</script>

<style>
  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    margin-top: 2rem;
  }
  .contact-form label {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }
  .contact-form label > span {
    font-family: "JetBrains Mono", monospace;
    font-size: 0.85rem;
    font-weight: 700;
    text-transform: lowercase;
    letter-spacing: 0.04em;
    color: var(--color-deep-tidewater);
  }
  .contact-form input,
  .contact-form select,
  .contact-form textarea {
    font-family: "Inter", sans-serif;
    font-size: 1rem;
    padding: 0.75rem 0.9rem;
    border: 3px solid var(--color-deep-tidewater);
    background: var(--color-vellum);
    color: #1a1a1a;
    border-radius: 0;
    box-shadow: 3px 3px 0 0 var(--color-deep-tidewater);
  }
  .contact-form input:focus,
  .contact-form select:focus,
  .contact-form textarea:focus {
    outline: none;
    box-shadow: 5px 5px 0 0 var(--color-deep-tidewater);
  }
  .contact-form button[type="submit"] {
    align-self: flex-start;
    cursor: pointer;
  }
  .note {
    margin-top: 1.5rem;
    font-size: 0.85rem;
    color: var(--color-deep-tidewater);
    opacity: 0.7;
  }
  .contact-form label .hint {
    font-family: "iA Writer Quattro", monospace;
    font-size: 0.8rem;
    color: var(--color-deep-tidewater);
    text-decoration: none;
    margin-top: 0.35rem;
    opacity: 0.78;
    align-self: flex-start;
  }
  .contact-form label .hint:hover {
    opacity: 1;
    text-decoration: underline;
  }

  /* Honeypot — visually hidden but still in the DOM so bots see and fill it.
     Using position: absolute + clip rather than display: none because some
     bots skip display:none inputs. */
  .hp {
    position: absolute;
    left: -10000px;
    top: auto;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .form-error {
    margin: 0.5rem 0 0;
    padding: 0.6rem 0.8rem;
    background: rgba(255, 64, 64, 0.08);
    border-left: 3px solid #c0392b;
    color: #2c3d42;
    font-family: "iA Writer Quattro", monospace;
    font-size: 0.85rem;
    line-height: 1.5;
  }

  button[disabled] {
    opacity: 0.7;
    cursor: wait;
  }
</style>
