---
// Bare, standalone calculator — no site chrome, no Foldster's branding.
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Partner Average Calculator</title>
  <meta name="description" content="Work out how much longer (or how many viewers) you need to hit a 75-viewer stream average." />
</head>
<body>
  <main>
    <h1>Partner Average Calculator</h1>

    <div class="grid">
      <label>
        <span>Current average</span>
        <input id="current-avg" type="number" min="0" step="0.1" value="50" inputmode="decimal" />
      </label>
      <label>
        <span>Uptime so far (hrs)</span>
        <input id="current-uptime" type="number" min="0" step="0.1" value="2" inputmode="decimal" />
      </label>
      <label>
        <span>Target average</span>
        <input id="target-avg" type="number" min="1" step="0.5" value="75" inputmode="decimal" />
      </label>
    </div>

    <div class="tabs">
      <button class="tab active" data-mode="time" type="button">Solve for time</button>
      <button class="tab" data-mode="viewers" type="button">Solve for viewers</button>
    </div>

    <div id="panel-time">
      <label class="block">
        <span>Sustained viewers going forward</span>
        <input id="future-avg-input" type="number" min="0" step="1" value="100" inputmode="numeric" />
      </label>
    </div>

    <div id="panel-viewers" hidden>
      <label class="block">
        <span>Remaining stream time (hrs)</span>
        <input id="future-uptime-input" type="number" min="0" step="0.25" value="2" inputmode="decimal" />
      </label>
    </div>

    <div id="result" class="result"></div>
  </main>

  <style is:global>
    :root {
      color-scheme: dark;
      --bg: #121417;
      --panel: #1c1f23;
      --panel-2: #262a30;
      --text: #e7e9ec;
      --muted: #8d949c;
      --border: #2f343b;
      --accent: #9146FF;
      --good: #2ea05a;
      --bad: #c54040;
    }
    html, body {
      margin: 0;
      padding: 0;
      background: var(--bg);
      color: var(--text);
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      min-height: 100dvh;
    }
    main {
      max-width: 520px;
      margin: 0 auto;
      padding: 32px 20px 64px;
    }
    h1 {
      font-size: 20px;
      font-weight: 600;
      margin: 0 0 24px;
      color: var(--text);
    }
    .grid {
      display: grid;
      grid-template-columns: 1fr 1fr 1fr;
      gap: 10px;
      margin-bottom: 20px;
    }
    @media (max-width: 480px) {
      .grid { grid-template-columns: 1fr; }
    }
    label {
      display: flex;
      flex-direction: column;
      gap: 4px;
      font-size: 12px;
      color: var(--muted);
    }
    label.block {
      margin: 12px 0 0;
    }
    input {
      font-family: inherit;
      font-size: 15px;
      padding: 8px 10px;
      background: var(--panel);
      color: var(--text);
      border: 1px solid var(--border);
      border-radius: 4px;
      width: 100%;
      box-sizing: border-box;
    }
    input:focus {
      outline: none;
      border-color: var(--accent);
    }
    .tabs {
      display: flex;
      gap: 0;
      margin: 8px 0 8px;
      border-bottom: 1px solid var(--border);
    }
    .tab {
      font-family: inherit;
      font-size: 13px;
      font-weight: 500;
      padding: 8px 14px;
      background: transparent;
      border: none;
      border-bottom: 2px solid transparent;
      margin-bottom: -1px;
      color: var(--muted);
      cursor: pointer;
    }
    .tab.active {
      color: var(--text);
      border-bottom-color: var(--accent);
    }
    .result {
      background: var(--panel);
      border: 1px solid var(--border);
      padding: 14px 16px;
      border-radius: 4px;
      margin-top: 20px;
      min-height: 48px;
      line-height: 1.5;
      font-size: 14px;
      color: var(--text);
    }
    .result strong { color: white; }
    .result .hint {
      display: block;
      margin-top: 4px;
      font-size: 12px;
      color: var(--muted);
    }
    .result.bad { border-color: var(--bad); }
    .result.good { border-color: var(--good); }
  </style>

  <script is:inline>
    (function () {
      const $ = (id) => document.getElementById(id);
      const fmtHours = (h) => {
        if (!isFinite(h) || h < 0) return String(h);
        const hh = Math.floor(h);
        const mm = Math.round((h - hh) * 60);
        if (hh === 0) return `${mm}m`;
        if (mm === 0) return `${hh}h`;
        return `${hh}h ${mm}m`;
      };
      const fmtNum = (n, d = 1) => isFinite(n) ? n.toFixed(d).replace(/\.0+$/, "") : String(n);

      let mode = "time";

      function setMode(next) {
        mode = next;
        document.querySelectorAll(".tab").forEach((b) =>
          b.classList.toggle("active", b.dataset.mode === next),
        );
        $("panel-time").hidden = next !== "time";
        $("panel-viewers").hidden = next !== "viewers";
        compute();
      }

      function compute() {
        const ca = parseFloat($("current-avg").value);
        const cu = parseFloat($("current-uptime").value);
        const D = parseFloat($("target-avg").value);
        const r = $("result");
        r.className = "result";

        if (!isFinite(ca) || !isFinite(cu) || !isFinite(D) || cu < 0 || D <= 0) {
          r.textContent = "Fill in the inputs above.";
          return;
        }
        if (ca >= D) {
          r.classList.add("good");
          r.innerHTML = `<strong>${fmtNum(ca)}</strong> average is already past the <strong>${fmtNum(D)}</strong> target.`;
          return;
        }

        if (mode === "time") {
          const fa = parseFloat($("future-avg-input").value);
          if (!isFinite(fa) || fa < 0) { r.textContent = "Enter a viewer count."; return; }
          if (fa <= D) {
            r.classList.add("bad");
            r.innerHTML = `<strong>${fmtNum(fa)}</strong> sustained viewers won't reach <strong>${fmtNum(D)}</strong> — needs to exceed the target.`;
            return;
          }
          const fu = (cu * (D - ca)) / (fa - D);
          r.classList.add("good");
          r.innerHTML = `<strong>${fmtHours(fu)}</strong> more at <strong>${fmtNum(fa)}</strong> sustained viewers lands you at <strong>${fmtNum(D)}</strong> average.<span class="hint">Total stream: ${fmtHours(cu + fu)}.</span>`;
          return;
        }

        const fu = parseFloat($("future-uptime-input").value);
        if (!isFinite(fu) || fu <= 0) { r.textContent = "Enter a duration."; return; }
        const fa = (D * (cu + fu) - ca * cu) / fu;
        if (fa < 0) {
          r.classList.add("good");
          r.innerHTML = `<strong>0</strong> viewers are enough for the next <strong>${fmtHours(fu)}</strong> — you'd still land past <strong>${fmtNum(D)}</strong>.`;
          return;
        }
        r.classList.add("good");
        r.innerHTML = `<strong>${fmtNum(fa)}</strong> average viewers are needed for the next <strong>${fmtHours(fu)}</strong> to land at <strong>${fmtNum(D)}</strong>.`;
      }

      document.querySelectorAll(".tab").forEach((b) => {
        b.addEventListener("click", () => setMode(b.dataset.mode));
      });
      ["current-avg","current-uptime","target-avg","future-avg-input","future-uptime-input"].forEach((id) => {
        $(id).addEventListener("input", compute);
      });
      compute();
    })();
  </script>
</body>
</html>
