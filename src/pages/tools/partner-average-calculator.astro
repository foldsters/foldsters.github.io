---
// Bare, standalone calculator — no site chrome, no Foldster's branding.
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Partner Average Calculator</title>
  <meta name="description" content="Work out how much longer (or how many viewers) you need to hit a 75-viewer stream average." />
</head>
<body>
  <main>
    <h1>Partner Average Calculator</h1>

    <div class="grid">
      <label>
        <span>Current average</span>
        <input id="current-avg" type="number" min="0" step="0.1" value="50" inputmode="decimal" />
      </label>
      <label>
        <span>Uptime so far</span>
        <div class="hm">
          <input id="current-uptime-h" type="number" min="0" step="1" value="2" inputmode="numeric" /><span class="unit">h</span>
          <input id="current-uptime-m" type="number" min="0" max="59" step="1" value="0" inputmode="numeric" /><span class="unit">m</span>
          <button id="clock-toggle" class="clock-btn" type="button" title="Start clock">▶</button>
        </div>
      </label>
      <label>
        <span>Target average</span>
        <input id="target-avg" type="number" min="1" step="0.5" value="75" inputmode="decimal" />
      </label>
    </div>

    <div class="tabs">
      <button class="tab active" data-mode="time" type="button">Solve for time</button>
      <button class="tab" data-mode="viewers" type="button">Solve for viewers</button>
    </div>

    <div id="panel-time">
      <label class="block">
        <span>Sustained viewers going forward</span>
        <input id="future-avg-input" type="number" min="0" step="1" value="100" inputmode="numeric" />
      </label>
    </div>

    <div id="panel-viewers" hidden>
      <label class="block">
        <span>Remaining stream time</span>
        <div class="hm">
          <input id="future-uptime-h" type="number" min="0" step="1" value="2" inputmode="numeric" /><span class="unit">h</span>
          <input id="future-uptime-m" type="number" min="0" max="59" step="1" value="0" inputmode="numeric" /><span class="unit">m</span>
        </div>
      </label>
    </div>

    <div id="result" class="result"></div>
    <svg id="graph" viewBox="0 0 320 240"></svg>
  </main>

  <style is:global>
    :root {
      color-scheme: dark;
      --bg: #121417;
      --panel: #1c1f23;
      --panel-2: #262a30;
      --text: #e7e9ec;
      --muted: #8d949c;
      --border: #2f343b;
      --accent: #9146FF;
      --good: #2ea05a;
      --bad: #c54040;
    }
    html, body {
      margin: 0;
      padding: 0;
      background: var(--bg);
      color: var(--text);
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      min-height: 100dvh;
    }
    main {
      max-width: 520px;
      margin: 0 auto;
      padding: 32px 20px 64px;
    }
    h1 {
      font-size: 20px;
      font-weight: 600;
      margin: 0 0 24px;
      color: var(--text);
    }
    .grid {
      display: grid;
      grid-template-columns: 1fr 1fr 1fr;
      gap: 10px;
      margin-bottom: 20px;
    }
    @media (max-width: 480px) {
      .grid { grid-template-columns: 1fr; }
    }
    label {
      display: flex;
      flex-direction: column;
      gap: 4px;
      font-size: 12px;
      color: var(--muted);
    }
    label.block {
      margin: 12px 0 0;
    }
    input {
      font-family: inherit;
      font-size: 15px;
      padding: 8px 10px;
      background: var(--panel);
      color: var(--text);
      border: 1px solid var(--border);
      border-radius: 4px;
      width: 100%;
      box-sizing: border-box;
    }
    input:focus {
      outline: none;
      border-color: var(--accent);
    }
    .hm {
      display: flex;
      align-items: center;
      gap: 6px;
    }
    .hm input {
      width: 0;
      flex: 1;
      text-align: left;
    }
    .hm .unit {
      font-size: 12px;
      color: var(--muted);
    }
    .clock-btn {
      flex: 0 0 auto;
      width: 32px;
      padding: 6px 0;
      background: transparent;
      border: 1px solid var(--border);
      color: var(--muted);
      border-radius: 4px;
      cursor: pointer;
      font-size: 12px;
      line-height: 1;
    }
    .clock-btn:hover { color: var(--text); }
    .clock-btn.active {
      background: var(--good);
      color: white;
      border-color: var(--good);
    }
    .tabs {
      display: flex;
      gap: 0;
      margin: 8px 0 8px;
      border-bottom: 1px solid var(--border);
    }
    .tab {
      font-family: inherit;
      font-size: 13px;
      font-weight: 500;
      padding: 8px 14px;
      background: transparent;
      border: none;
      border-bottom: 2px solid transparent;
      margin-bottom: -1px;
      color: var(--muted);
      cursor: pointer;
    }
    .tab.active {
      color: var(--text);
      border-bottom-color: var(--accent);
    }
    .result {
      background: var(--panel);
      border: 1px solid var(--border);
      padding: 14px 16px;
      border-radius: 4px;
      margin-top: 20px;
      min-height: 48px;
      line-height: 1.5;
      font-size: 14px;
      color: var(--text);
    }
    .result strong { color: white; }
    .result .hint {
      display: block;
      margin-top: 4px;
      font-size: 12px;
      color: var(--muted);
    }
    .result.bad { border-color: var(--bad); }
    .result.good { border-color: var(--good); }
    #graph {
      width: 100%;
      height: auto;
      aspect-ratio: 320 / 240;
      display: block;
      margin-top: 12px;
      background: var(--panel);
      border: 1px solid var(--border);
      border-radius: 4px;
    }
    #graph:empty { display: none; }
  </style>

  <script is:inline>
    (function () {
      const $ = (id) => document.getElementById(id);
      const fmtHours = (h) => {
        if (!isFinite(h) || h < 0) return String(h);
        const hh = Math.floor(h);
        const mm = Math.round((h - hh) * 60);
        if (hh === 0) return `${mm}m`;
        if (mm === 0) return `${hh}h`;
        return `${hh}h ${mm}m`;
      };
      const fmtNum = (n, d = 1) => isFinite(n) ? n.toFixed(d).replace(/\.0+$/, "") : String(n);

      let mode = "time";

      function setMode(next) {
        mode = next;
        document.querySelectorAll(".tab").forEach((b) =>
          b.classList.toggle("active", b.dataset.mode === next),
        );
        $("panel-time").hidden = next !== "time";
        $("panel-viewers").hidden = next !== "viewers";
        compute();
      }

      const hm = (hId, mId) => {
        const h = parseFloat($(hId).value);
        const m = parseFloat($(mId).value);
        return (isFinite(h) ? h : 0) + (isFinite(m) ? m / 60 : 0);
      };

      function drawGraph(ca, cu, D, fa, fu) {
        const svg = $("graph");
        if (!isFinite(fa) || !isFinite(fu) || fu <= 0 || cu < 0) { svg.innerHTML = ""; return; }
        const tMax = cu + fu;
        if (tMax <= 0) { svg.innerHTML = ""; return; }
        const W = 320, H = 240, padL = 8, padR = 8, padT = 10, padB = 16;
        const innerW = W - padL - padR;
        const innerH = H - padT - padB;
        const yMax = Math.max(D, fa, ca) * 1.18 + 1;
        const yMin = 0;
        const mapX = (t) => padL + (t / tMax) * innerW;
        const mapY = (v) => padT + innerH - ((v - yMin) / (yMax - yMin)) * innerH;

        // Past segment: flat at ca from t=0 to t=cu
        // Future segment: running avg from t=cu to t=cu+fu
        let path = "";
        if (cu > 0) {
          path += `M${mapX(0).toFixed(1)},${mapY(ca).toFixed(1)} L${mapX(cu).toFixed(1)},${mapY(ca).toFixed(1)} `;
        } else {
          path += `M${mapX(0).toFixed(1)},${mapY(ca).toFixed(1)} `;
        }
        const STEPS = 80;
        for (let i = 1; i <= STEPS; i++) {
          const t = cu + (i / STEPS) * fu;
          const avg = (ca * cu + fa * (t - cu)) / t;
          path += `L${mapX(t).toFixed(1)},${mapY(avg).toFixed(1)} `;
        }

        const targetY = mapY(D);
        const nowX = mapX(cu);
        const nowY = mapY(ca);

        // Intercept: only show if curve actually crosses target within window
        let interceptSvg = "";
        if (ca < D && fa > D) {
          const tInt = (cu * (fa - ca)) / (fa - D);
          if (tInt <= tMax + 1e-6) {
            const ix = mapX(tInt);
            interceptSvg = `<circle cx="${ix.toFixed(1)}" cy="${targetY.toFixed(1)}" r="4" fill="#9146FF" stroke="#e7e9ec" stroke-width="1.5"/>`;
          }
        }

        svg.innerHTML = `
          <line x1="${padL}" y1="${targetY.toFixed(1)}" x2="${(W - padR).toFixed(1)}" y2="${targetY.toFixed(1)}" stroke="#c54040" stroke-dasharray="4,3" stroke-width="1"/>
          <text x="${(W - padR - 4).toFixed(1)}" y="${(targetY - 4).toFixed(1)}" text-anchor="end" font-size="10" fill="#c54040" font-family="-apple-system, sans-serif">target ${fmtNum(D)}</text>
          <path d="${path}" fill="none" stroke="#2ea05a" stroke-width="2"/>
          <circle cx="${nowX.toFixed(1)}" cy="${nowY.toFixed(1)}" r="3" fill="#8d949c"/>
          <text x="${nowX.toFixed(1)}" y="${(H - 4).toFixed(1)}" text-anchor="middle" font-size="9" fill="#8d949c" font-family="-apple-system, sans-serif">now</text>
          ${interceptSvg}
          <text x="${padL.toFixed(1)}" y="${(H - 4).toFixed(1)}" font-size="9" fill="#8d949c" font-family="-apple-system, sans-serif">0h</text>
          <text x="${(W - padR).toFixed(1)}" y="${(H - 4).toFixed(1)}" text-anchor="end" font-size="9" fill="#8d949c" font-family="-apple-system, sans-serif">${fmtHours(tMax)}</text>
        `;
      }

      function compute() {
        const ca = parseFloat($("current-avg").value);
        const cu = hm("current-uptime-h", "current-uptime-m");
        const D = parseFloat($("target-avg").value);
        const r = $("result");
        const svg = $("graph");
        r.className = "result";
        svg.innerHTML = "";

        if (!isFinite(ca) || !isFinite(cu) || !isFinite(D) || cu < 0 || D <= 0) {
          r.textContent = "Fill in the inputs above.";
          return;
        }
        if (ca >= D) {
          r.classList.add("good");
          r.innerHTML = `<strong>${fmtNum(ca)}</strong> average is already past the <strong>${fmtNum(D)}</strong> target.`;
          return;
        }

        if (mode === "time") {
          const fa = parseFloat($("future-avg-input").value);
          if (!isFinite(fa) || fa < 0) { r.textContent = "Enter a viewer count."; return; }
          if (fa <= D) {
            r.classList.add("bad");
            r.innerHTML = `<strong>${fmtNum(fa)}</strong> sustained viewers won't reach <strong>${fmtNum(D)}</strong> — needs to exceed the target.`;
            return;
          }
          const fu = (cu * (D - ca)) / (fa - D);
          r.classList.add("good");
          r.innerHTML = `<strong>${fmtHours(fu)}</strong> more at <strong>${fmtNum(fa)}</strong> sustained viewers lands you at <strong>${fmtNum(D)}</strong> average.<span class="hint">Total stream: ${fmtHours(cu + fu)}.</span>`;
          drawGraph(ca, cu, D, fa, fu);
          return;
        }

        const fu = hm("future-uptime-h", "future-uptime-m");
        if (!isFinite(fu) || fu <= 0) { r.textContent = "Enter a duration."; return; }
        const fa = (D * (cu + fu) - ca * cu) / fu;
        if (fa < 0) {
          r.classList.add("good");
          r.innerHTML = `<strong>0</strong> viewers are enough for the next <strong>${fmtHours(fu)}</strong> — you'd still land past <strong>${fmtNum(D)}</strong>.`;
          return;
        }
        r.classList.add("good");
        r.innerHTML = `<strong>${fmtNum(fa)}</strong> average viewers are needed for the next <strong>${fmtHours(fu)}</strong> to land at <strong>${fmtNum(D)}</strong>.`;
        drawGraph(ca, cu, D, fa, fu);
      }

      document.querySelectorAll(".tab").forEach((b) => {
        b.addEventListener("click", () => setMode(b.dataset.mode));
      });
      ["current-avg","target-avg","future-avg-input","future-uptime-h","future-uptime-m"].forEach((id) => {
        $(id).addEventListener("input", compute);
      });

      // Clock auto-increment for "uptime so far". State persists in localStorage
      // so a refresh keeps the clock running. Manual edits to the uptime inputs
      // while the clock is on re-anchor startMs to the typed value.
      const CLOCK_KEY = "pac-clock-start";
      let clockStartMs = null;
      let clockInterval = null;
      let internalUpdate = false;

      function startTicking() {
        if (clockInterval) return;
        clockInterval = window.setInterval(tick, 30000);
      }
      function stopTicking() {
        if (clockInterval) window.clearInterval(clockInterval);
        clockInterval = null;
      }
      function tick() {
        if (!clockStartMs) return;
        const totalH = (Date.now() - clockStartMs) / 3600000;
        const hh = Math.floor(totalH);
        const mm = Math.floor((totalH - hh) * 60);
        internalUpdate = true;
        $("current-uptime-h").value = String(hh);
        $("current-uptime-m").value = String(mm);
        internalUpdate = false;
        compute();
      }
      function updateClockUI() {
        const btn = $("clock-toggle");
        if (clockStartMs) {
          btn.textContent = "■";
          btn.title = "Stop clock";
          btn.classList.add("active");
        } else {
          btn.textContent = "▶";
          btn.title = "Start clock";
          btn.classList.remove("active");
        }
      }
      function startClock() {
        const hours = hm("current-uptime-h", "current-uptime-m");
        clockStartMs = Date.now() - hours * 3600000;
        localStorage.setItem(CLOCK_KEY, String(clockStartMs));
        startTicking();
        updateClockUI();
        tick();
      }
      function stopClock() {
        clockStartMs = null;
        localStorage.removeItem(CLOCK_KEY);
        stopTicking();
        updateClockUI();
      }
      $("clock-toggle").addEventListener("click", () => {
        if (clockStartMs) stopClock(); else startClock();
      });
      ["current-uptime-h","current-uptime-m"].forEach((id) => {
        $(id).addEventListener("input", () => {
          if (!internalUpdate && clockStartMs) {
            // user edited while clock running — re-anchor to typed value
            const hours = hm("current-uptime-h", "current-uptime-m");
            clockStartMs = Date.now() - hours * 3600000;
            localStorage.setItem(CLOCK_KEY, String(clockStartMs));
          }
          compute();
        });
      });

      // Resume from localStorage if a clock was running
      const stored = parseInt(localStorage.getItem(CLOCK_KEY) || "", 10);
      if (isFinite(stored)) {
        clockStartMs = stored;
        startTicking();
        updateClockUI();
        tick();
      }

      compute();
    })();
  </script>
</body>
</html>
