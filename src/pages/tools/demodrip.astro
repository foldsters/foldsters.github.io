---
import LayoutPage from '../../layouts/LayoutPage.astro';
import { Image } from 'astro:assets';
import demodrip1 from '../../content/images/demodrip/demodrip-1.png';
---

<LayoutPage title="Foldster's Projects — Demodrip" description="Shader-based t-shirt design tool">
  <h1>Demodrip.</h1>
  <p class="lede"><em>shader t-shirt designer · open source · free</em></p>

  <Image src={demodrip1} alt="Demodrip screenshot — shader rendered on a 3D t-shirt model" class="hero-image"/>

  <p>
    Write GLSL fragment shaders, preview them live on a 3D t-shirt model, export print-ready textures.
    Tabbed shader editing, URL-based sharing (including animated shaders via <code>iTime</code> param),
    and a clean export pipeline for all-around printing services.
  </p>

  <h2>What it does</h2>
  <ul>
    <li>Live shader editor with multi-tab support</li>
    <li>3D t-shirt preview (React Three Fiber)</li>
    <li>Animated shaders via <code>iTime</code> parameter</li>
    <li>URL sharing — full shader state encoded in the link</li>
    <li>Texture export for all-around print services</li>
  </ul>

  <h2>Stack</h2>
  <p><em>React 18 / TypeScript / Vite / Three.js / React Three Fiber</em></p>

  <h2>Try it</h2>
  <p><a href="https://demodrip.app" target="_blank">demodrip.app</a></p>

  <a href="/contact/" class="cta" slot="cta">want a custom version for your stream? &rarr;</a>
</LayoutPage>

<style>
  .hero-image {
    width: 100%;
    height: auto;
    margin: 1.25rem 0 1.75rem;
    border-radius: 4px;
  }
</style>
