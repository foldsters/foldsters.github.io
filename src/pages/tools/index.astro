---
import LayoutPage from '../../layouts/LayoutPage.astro';
import { Image } from 'astro:assets';
import demodripThumb from '../../content/images/demodrip/demodrip-1.png';
import pitchFieldThumb from '../../content/images/pitch-field/pitch-field-1.png';
import demoskyThumb from '../../content/images/demosky/demosky-1.png';
import paletteThumb from '../../content/images/palette/extractor.png';
---

<LayoutPage title="Foldster's Projects — Tools" description="Free open-source tools for creators">
  <h1>Free Tools</h1>
  <p class="lede"><em>All real, all working, all free. Use them as-is — or commission a custom version tailored to your brand.</em></p>

  <ul class="entry-list">
    <li class="entry-block">
      <div class="entry-content">
        <h3><a href="/tools/collectory/">Collectory</a></h3>
        <p class="entry-meta"><em>Foldster | Tool | in progress, collectory.app</em></p>
        <p>Browser-based, drag-and-drop tracker maker for streamers. Drop icons onto a grid, define per-icon state cycles, share a build via code, and embed it as an OBS browser source. Twitch auth + Convex real-time backend.</p>
      </div>
    </li>

    <li class="entry-block">
      <div class="entry-content">
        <h3><a href="/tools/twitch-partner-calculator/">Twitch Partner Calculator</a></h3>
        <p class="entry-meta"><em>Foldster | Tool | free to use</em></p>
        <p>Work out how much longer — or how many more viewers — you need to hit Twitch's 75-viewer Partner average. Solve for time or viewers, live-updating from your current session.</p>
      </div>
    </li>

    <li class="entry-block">
      <Image src={pitchFieldThumb} alt="Pitch Field — the 2D pitch instrument mid-play with a chromatic spotlight and Roman numerals" class="entry-thumb"/>
      <div class="entry-content">
        <h3><a href="/tools/pitch-field/">Pitch Field</a></h3>
        <p class="entry-meta"><em>Foldster | Tool | free to use</em></p>
        <p>A 2D pitch-space instrument. The X axis picks a note or chord, the Y axis is the average pitch, and it sounds across every octave under an adjustable Gaussian spotlight. Chromatic, circle-of-fifths, thirds, and suspended-chord wheels — rotatable to any key, with live Roman-numeral analysis. Pure Web Audio, no dependencies.</p>
      </div>
    </li>

    <li class="entry-block">
      <Image src={demodripThumb} alt="Demodrip — shader rendered on a 3D t-shirt" class="entry-thumb"/>
      <div class="entry-content">
        <h3><a href="/tools/demodrip/">Demodrip</a></h3>
        <p class="entry-meta"><em>Foldster | Tool | open source, demodrip.app</em></p>
        <p>Write GLSL shaders, preview them live on a 3D t-shirt model, export print-ready textures. The shader → merch pipeline.</p>
      </div>
    </li>

    <li class="entry-block">
      <div class="entry-content">
        <h3><a href="/tools/demowall/">Demowall</a></h3>
        <p class="entry-meta"><em>Foldster | Tool | open source, Google Play</em></p>
        <p>GLSL fragment shaders as animated Android live wallpapers. Built-in shaders, write your own in-app, or load community shaders from Bluesky via Demosky.</p>
      </div>
    </li>

    <li class="entry-block">
      <Image src={demoskyThumb} alt="Demosky — Bluesky shader feed client" class="entry-thumb"/>
      <div class="entry-content">
        <h3><a href="/tools/demosky/">Demosky</a></h3>
        <p class="entry-meta"><em>Foldster | Tool | open source, demosky.app</em></p>
        <p>Cross-platform Bluesky client for browsing and sharing shader demos. The social hub for the shader ecosystem.</p>
      </div>
    </li>

    <li class="entry-block">
      <Image src={paletteThumb} alt="Palettope — topology-aware palette extractor" class="entry-thumb"/>
      <div class="entry-content">
        <h3><a href="/tools/palette/">Palettope</a></h3>
        <p class="entry-meta"><em>Foldster | Tool | open source</em></p>
        <p>Topology-aware SOM palette extraction. Extract palettes from any image onto a sphere, torus, Klein bottle, or arbitrary graph. The tool used to extract this site's brand colors.</p>
      </div>
    </li>

    <li class="entry-block">
      <div class="entry-content">
        <h3><a href="/tools/foldster-studio/">Foldster Studio</a></h3>
        <p class="entry-meta"><em>Foldster | Tool | open source, PoC</em></p>
        <p>Browser-native streaming. Stream any canvas-based web app to stream.place with one function call. No OBS, no FFmpeg, no relay server. Works on phone.</p>
      </div>
    </li>

    <li class="entry-block">
      <div class="entry-content">
        <h3><a href="/tools/emotions-dev/">Emotions.dev</a></h3>
        <p class="entry-meta"><em>Foldster | Tool | newly shipped</em></p>
        <p>An emotions toolkit. Newly shipped — full writeup coming.</p>
      </div>
    </li>
  </ul>

  <a href="/contact/" class="cta" slot="cta">Want a custom version of any of these? &rarr;</a>
</LayoutPage>
