---
import LayoutPage from '../../layouts/LayoutPage.astro';
import { Image } from 'astro:assets';
import demosky1 from '../../content/images/demosky/demosky-1.png';
---

<LayoutPage title="Foldster's Projects — Demosky" description="Bluesky client for shader demos">
  <h1>Demosky.</h1>
  <p class="lede"><em>bluesky client for shaders · open source · free</em></p>

  <Image src={demosky1} alt="Demosky screenshot — Bluesky shader-feed client" class="hero-image"/>

  <p>
    A custom Bluesky client for browsing and sharing shader demos.
    Posts a snapshot of your shader as the visible image and injects the shader source into the post's metadata —
    so the Demosky client can render it live in real-time when other users view your post.
  </p>

  <h2>What it does</h2>
  <ul>
    <li>Cross-platform Bluesky client (web + React Native)</li>
    <li>Renders shaders inline in the feed</li>
    <li>OAuth with DPoP tokens</li>
    <li>Bidirectional with <a href="/tools/demowall/">Demowall</a> — set anyone's shader as your wallpaper</li>
    <li>PWA with service worker</li>
  </ul>

  <h2>Stack</h2>
  <p><em>React Native + Expo / TypeScript / @atproto/api (OAuth + DPoP)</em></p>

  <h2>Try it</h2>
  <p><a href="https://demosky.app" target="_blank">demosky.app</a></p>

  <a href="/contact/" class="cta" slot="cta">want a branded version of this for your community? &rarr;</a>
</LayoutPage>

<style>
  .hero-image {
    width: 100%;
    height: auto;
    margin: 1.25rem 0 1.75rem;
    border-radius: 4px;
  }
</style>
